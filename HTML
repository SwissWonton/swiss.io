<!DOCTYPE html>
<html>
<head>
  <title>Catch the Square</title>
  <style>
    body {
      text-align: center;
      font-family: Arial, sans-serif;
      background: #202124;
      color: white;
    }

    #game {
      width:  min(90vw, 600px);
      height: 400px;
      margin: 20px auto;
      background: #f1f1f1;
      position: relative;
      border: 4px solid #4285f4;
      overflow: hidden;
    }

    #square {
      width: 50px;
      height: 50px;
      background: #e91e63;
      position: absolute;
      cursor: pointer;
      display: none;
    }

    button {
      padding: 12px 24px;
      font-size: 16px;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <h1>Catch the Square!</h1>
  <p>Score: <span id="score">0</span></p>
  <p>Time: <span id="time">30</span> seconds</p>

  <button onclick="startGame()">Start Game</button>

  <div id="game">
    <div id="square" onclick="catchSquare()"></div>
  </div>

  <script>
    let score = 0;
    let time = 30;
    let timer;

    function startGame() {
      score = 0;
      time = 30;
      document.getElementById("score").textContent = score;
      document.getElementById("time").textContent = time;

      const square = document.getElementById("square");
      square.style.display = "block";
      moveSquare();

      clearInterval(timer);

      timer = setInterval(() => {
        time--;
        document.getElementById("time").textContent = time;

        if (time <= 0) {
          clearInterval(timer);
          square.style.display = "none";
          alert("Game over! Your score was " + score);
        }
      }, 1000);
    }

    function catchSquare() {
      score++;
      document.getElementById("score").textContent = score;
      moveSquare();
    }

    function moveSquare() {
      const game = document.getElementById("game");
      const square = document.getElementById("square");

      const maxX = game.clientWidth - square.clientWidth;
      const maxY = game.clientHeight - square.clientHeight;

      square.style.left = Math.random() * maxX + "px";
      square.style.top = Math.random() * maxY + "px";
    }
  </script>

</body>
</html>
